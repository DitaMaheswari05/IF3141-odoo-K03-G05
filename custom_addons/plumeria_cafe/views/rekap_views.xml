<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ============================================================
         REKAP KEUANGAN - FORM VIEW
    ============================================================ -->
    <record id="view_rekap_form" model="ir.ui.view">
        <field name="name">plumeria.rekap.keuangan.form</field>
        <field name="model">plumeria.rekap.keuangan</field>
        <field name="arch" type="xml">
            <form string="Rekap Keuangan Harian">
                <header>
                    <field name="status_rekonsiliasi" widget="statusbar"
                        statusbar_visible="pending,cocok,selisih"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <!-- Alert: Selisih Ditemukan -->
                    <div class="alert alert-danger" role="alert"
                        invisible="status_rekonsiliasi != 'selisih'">
                        <strong>&#9888; Selisih Ditemukan!</strong>
                        Terdapat perbedaan antara kas aktual dan data POS.
                        Selisih: <field name="delta" widget="monetary"
                            options="{'currency_field': false}" readonly="1" nolabel="1"/>
                    </div>

                    <!-- Alert: Cocok -->
                    <div class="alert alert-success" role="alert"
                        invisible="status_rekonsiliasi != 'cocok'">
                        <strong>&#10003; Rekonsiliasi Berhasil!</strong>
                        Data kas sesuai dengan data POS. Laporan terkait akan otomatis diarsipkan.
                    </div>

                    <group>
                        <group string="Informasi Rekap">
                            <field name="tanggal"/>
                            <field name="divisi"/>
                        </group>
                        <group string="Status Rekonsiliasi">
                            <field name="status_rekonsiliasi" widget="badge"
                                decoration-success="status_rekonsiliasi == 'cocok'"
                                decoration-danger="status_rekonsiliasi == 'selisih'"
                                decoration-warning="status_rekonsiliasi == 'pending'"/>
                            <field name="delta" widget="monetary"
                                options="{'currency_field': false}" readonly="1"/>
                        </group>
                    </group>

                    <group string="Perbandingan Data">
                        <group>
                            <field name="total_kas" widget="monetary"
                                options="{'currency_field': false}"/>
                        </group>
                        <group>
                            <field name="total_pos" widget="monetary"
                                options="{'currency_field': false}" readonly="1"/>
                            <button name="action_hitung_total_pos" type="object"
                                string="&#x21BB; Hitung Ulang dari POS"
                                class="btn-secondary btn-sm"
                                groups="plumeria_cafe.group_finance,plumeria_cafe.group_head_operations,plumeria_cafe.group_operational_coordinator"/>
                        </group>
                    </group>

                    <group string="Catatan">
                        <field name="catatan" nolabel="1" colspan="2"
                            placeholder="Tambahkan catatan rekonsiliasi..."/>
                    </group>

                    <notebook>
                        <page string="Laporan Terkait" name="laporan">
                            <field name="laporan_ids">
                                <tree>
                                    <field name="nomor_referensi"/>
                                    <field name="tanggal"/>
                                    <field name="divisi"/>
                                    <field name="total_pendapatan" widget="monetary"
                                        options="{'currency_field': false}"/>
                                    <field name="state" widget="badge"
                                        decoration-success="state == 'approved'"
                                        decoration-warning="state == 'submitted'"
                                        decoration-muted="state == 'archived'"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================
         REKAP KEUANGAN - TREE VIEW
    ============================================================ -->
    <record id="view_rekap_tree" model="ir.ui.view">
        <field name="name">plumeria.rekap.keuangan.tree</field>
        <field name="model">plumeria.rekap.keuangan</field>
        <field name="arch" type="xml">
            <tree string="Rekap Keuangan"
                decoration-success="status_rekonsiliasi == 'cocok'"
                decoration-danger="status_rekonsiliasi == 'selisih'"
                decoration-warning="status_rekonsiliasi == 'pending'">
                <field name="name"/>
                <field name="tanggal"/>
                <field name="divisi"/>
                <field name="total_kas" widget="monetary" options="{'currency_field': false}"/>
                <field name="total_pos" widget="monetary" options="{'currency_field': false}"/>
                <field name="delta" widget="monetary" options="{'currency_field': false}"/>
                <field name="status_rekonsiliasi" widget="badge"
                    decoration-success="status_rekonsiliasi == 'cocok'"
                    decoration-danger="status_rekonsiliasi == 'selisih'"
                    decoration-warning="status_rekonsiliasi == 'pending'"/>
            </tree>
        </field>
    </record>

    <!-- ============================================================
         REKAP KEUANGAN - SEARCH VIEW
    ============================================================ -->
    <record id="view_rekap_search" model="ir.ui.view">
        <field name="name">plumeria.rekap.keuangan.search</field>
        <field name="model">plumeria.rekap.keuangan</field>
        <field name="arch" type="xml">
            <search string="Cari Rekap Keuangan">
                <field name="tanggal"/>
                <filter string="Cocok" name="filter_cocok" domain="[('status_rekonsiliasi','=','cocok')]"/>
                <filter string="Selisih" name="filter_selisih" domain="[('status_rekonsiliasi','=','selisih')]"/>
                <filter string="Pending" name="filter_pending" domain="[('status_rekonsiliasi','=','pending')]"/>
                <separator/>
                <filter string="Bar" name="filter_bar" domain="[('divisi','=','bar')]"/>
                <filter string="Kitchen" name="filter_kitchen" domain="[('divisi','=','kitchen')]"/>
                <group expand="0" string="Group By">
                    <filter string="Divisi" name="group_divisi" context="{'group_by': 'divisi'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'status_rekonsiliasi'}"/>
                    <filter string="Tanggal" name="group_tanggal" context="{'group_by': 'tanggal'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================
         ACTION
    ============================================================ -->
    <record id="action_rekap_keuangan" model="ir.actions.act_window">
        <field name="name">Rekap &amp; Rekonsiliasi Keuangan</field>
        <field name="res_model">plumeria.rekap.keuangan</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_rekap_search"/>
    </record>

</odoo>
