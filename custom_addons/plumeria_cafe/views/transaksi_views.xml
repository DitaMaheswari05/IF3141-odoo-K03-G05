<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ============================================================
         TRANSAKSI POS - FORM VIEW
    ============================================================ -->
    <record id="view_transaksi_form" model="ir.ui.view">
        <field name="name">plumeria.transaksi.pos.form</field>
        <field name="model">plumeria.transaksi.pos</field>
        <field name="arch" type="xml">
            <form string="Transaksi POS">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="id_transaksi"/></h1>
                    </div>
                    <group>
                        <group string="Informasi Transaksi">
                            <field name="waktu_transaksi"/>
                            <field name="divisi"/>
                            <field name="metode_pembayaran"/>
                        </group>
                        <group string="Total">
                            <field name="total_transaksi" widget="monetary"
                                options="{'currency_field': false}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Detail Pesanan" name="detail">
                            <field name="detail_ids">
                                <tree editable="bottom">
                                    <field name="produk_id"/>
                                    <field name="jumlah"/>
                                    <field name="harga_satuan" widget="monetary"
                                        options="{'currency_field': false}"/>
                                    <field name="subtotal" widget="monetary"
                                        options="{'currency_field': false}"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================
         TRANSAKSI POS - TREE VIEW
    ============================================================ -->
    <record id="view_transaksi_tree" model="ir.ui.view">
        <field name="name">plumeria.transaksi.pos.tree</field>
        <field name="model">plumeria.transaksi.pos</field>
        <field name="arch" type="xml">
            <tree string="Data Transaksi POS">
                <field name="id_transaksi"/>
                <field name="waktu_transaksi"/>
                <field name="divisi"/>
                <field name="metode_pembayaran"/>
                <field name="total_transaksi" widget="monetary"
                    options="{'currency_field': false}" sum="Total Semua"/>
            </tree>
        </field>
    </record>

    <!-- ============================================================
         TRANSAKSI POS - GRAPH VIEW
    ============================================================ -->
    <record id="view_transaksi_graph" model="ir.ui.view">
        <field name="name">plumeria.transaksi.pos.graph</field>
        <field name="model">plumeria.transaksi.pos</field>
        <field name="arch" type="xml">
            <graph string="Tren Penjualan Harian" type="bar">
                <field name="waktu_transaksi" type="row" interval="day"/>
                <field name="total_transaksi" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ============================================================
         TRANSAKSI POS - PIVOT VIEW
    ============================================================ -->
    <record id="view_transaksi_pivot" model="ir.ui.view">
        <field name="name">plumeria.transaksi.pos.pivot</field>
        <field name="model">plumeria.transaksi.pos</field>
        <field name="arch" type="xml">
            <pivot string="Analisis Transaksi POS">
                <field name="divisi" type="row"/>
                <field name="metode_pembayaran" type="col"/>
                <field name="total_transaksi" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- ============================================================
         TRANSAKSI POS - SEARCH VIEW
    ============================================================ -->
    <record id="view_transaksi_search" model="ir.ui.view">
        <field name="name">plumeria.transaksi.pos.search</field>
        <field name="model">plumeria.transaksi.pos</field>
        <field name="arch" type="xml">
            <search string="Cari Transaksi">
                <field name="id_transaksi"/>
                <filter string="Bar" name="filter_bar" domain="[('divisi','=','bar')]"/>
                <filter string="Kitchen" name="filter_kitchen" domain="[('divisi','=','kitchen')]"/>
                <separator/>
                <filter string="QRIS" name="filter_qris" domain="[('metode_pembayaran','=','qris')]"/>
                <filter string="Tunai" name="filter_tunai" domain="[('metode_pembayaran','=','tunai')]"/>
                <filter string="Debit" name="filter_debit" domain="[('metode_pembayaran','=','debit')]"/>
                <group expand="0" string="Group By">
                    <filter string="Divisi" name="group_divisi" context="{'group_by': 'divisi'}"/>
                    <filter string="Metode Pembayaran" name="group_metode" context="{'group_by': 'metode_pembayaran'}"/>
                    <filter string="Tanggal" name="group_tanggal" context="{'group_by': 'waktu_transaksi:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================
         ACTIONS
    ============================================================ -->
    <record id="action_transaksi_pos" model="ir.actions.act_window">
        <field name="name">Data Transaksi POS</field>
        <field name="res_model">plumeria.transaksi.pos</field>
        <field name="view_mode">tree,form,graph,pivot</field>
        <field name="search_view_id" ref="view_transaksi_search"/>
    </record>

</odoo>
